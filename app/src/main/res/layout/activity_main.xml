<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#27100B" android:fillViewport="true"
    android:clipToPadding="false" android:paddingBottom="28dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:paddingStart="20dp"
        android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="36dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ॐ  SURWI" android:textColor="#FFD27A" android:textSize="28sp"
            android:textStyle="bold" android:gravity="center" android:paddingTop="16dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="VEDIC COMPASS  •  VASTU  •  PANCHANG" android:textColor="#E8B978"
            android:textSize="10sp" android:letterSpacing="0.12" android:gravity="center" android:paddingBottom="16dp"/>
        <TextView android:id="@+id/sensorStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Starting sensors…"
            android:textColor="#E8CDA7" android:textSize="12sp" android:padding="10dp"/>
        <TextView android:id="@+id/direction" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="--" android:textColor="#FFF1D4"
            android:textSize="42sp" android:textStyle="bold"/>
        <TextView android:id="@+id/degrees" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="---°" android:textColor="#FFD27A"
            android:textSize="28sp" android:textStyle="bold" android:paddingBottom="4dp"/>
        <com.surwi.compass360.CompassView android:id="@+id/compassView"
            android:layout_width="match_parent" android:layout_height="310dp"
            android:layout_marginTop="4dp" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:background="#482017"
                android:padding="14dp" android:layout_marginEnd="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LIVE HEADING" android:textColor="#E8B978" android:textSize="10sp"/>
                <TextView android:id="@+id/headingValue" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="---°" android:textColor="#FFF1D4"
                    android:textSize="20sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:background="#482017"
                android:padding="14dp" android:layout_marginStart="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SENSOR ACCURACY" android:textColor="#E8B978" android:textSize="10sp"/>
                <TextView android:id="@+id/accuracyValue" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Checking…" android:textColor="#FFF1D4"
                    android:textSize="20sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✦  VASTU SHASTRA · 16 DIRECTIONS" android:textColor="#FFD27A"
            android:textStyle="bold" android:textSize="17sp" android:paddingTop="26dp" android:paddingBottom="10dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#482017" android:padding="16dp" android:textColor="#FFF1D4"
            android:textSize="14sp" android:lineSpacingExtra="5dp"
            android:text="N · North / Kuber — traditionally associated with prosperity&#10;NE · Ishanya — prayer and meditation zone&#10;E · East / Indra — light and beginnings&#10;SE · Agneya — traditional kitchen/fire zone&#10;S · South / Yama — rest and discipline&#10;SW · Nairitya — traditionally master-bedroom zone&#10;W · West / Varuna — storage and children’s rooms in some traditions&#10;NW · Vayavya — movement and guest zone&#10;&#10;Intermediate zones: NNE, ENE, ESE, SSE, SSW, WSW, WNW and NNW. Classical texts and modern Vastu schools differ; treat these as references, not absolute rules."/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✦  NUMEROLOGY · QUICK CALCULATOR" android:textColor="#FFD27A"
            android:textStyle="bold" android:textSize="17sp" android:paddingTop="24dp" android:paddingBottom="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Enter date of birth in YYYY-MM-DD format. This calculates the commonly used birth number (day root) and life-path/destiny number (full date digit root). Numerology is a traditional belief system, not a scientific prediction."
            android:textColor="#E8CDA7" android:textSize="13sp" android:lineSpacingExtra="4dp" android:paddingBottom="10dp"/>
        <EditText android:id="@+id/dobInput" android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="YYYY-MM-DD  (e.g. 1998-07-24)" android:inputType="date"
            android:singleLine="true" android:padding="12dp" android:textColor="#FFF1D4"
            android:textColorHint="#C9A98A" android:background="#482017"/>
        <Button android:id="@+id/calculateNumbers" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="CALCULATE MY NUMBERS"
            android:textColor="#35140C" android:backgroundTint="#FFD27A" android:layout_marginTop="10dp"/>
        <TextView android:id="@+id/numerologyResult" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Your Mulank and Bhagyank will appear here."
            android:textColor="#FFF1D4" android:textSize="15sp" android:lineSpacingExtra="5dp"
            android:background="#482017" android:padding="14dp" android:layout_marginTop="10dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✦  VEDIC ASTROLOGY · JANMA KUNDLI" android:textColor="#FFD27A"
            android:textStyle="bold" android:textSize="17sp" android:paddingTop="24dp" android:paddingBottom="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#482017" android:padding="16dp" android:textColor="#FFF1D4"
            android:textSize="14sp" android:lineSpacingExtra="5dp"
            android:text="Planned chart: Janma Rashi (Moon sign), Lagna, Nakshatra and Pada, Navagraha positions, Vimshottari Dasha and Kundli. Accurate calculation needs birth date, exact local time, birthplace coordinates, timezone and a validated sidereal ephemeris. We will not guess a Rashi from DOB alone."/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✦  HINDU PANCHANG · FESTIVAL CALENDAR" android:textColor="#FFD27A"
            android:textStyle="bold" android:textSize="17sp" android:paddingTop="24dp" android:paddingBottom="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#482017" android:padding="16dp" android:textColor="#FFF1D4"
            android:textSize="14sp" android:lineSpacingExtra="5dp"
            android:text="Planned calendar: Tithi, Paksha, Vara, Nakshatra, Yoga, Karana, sunrise/sunset, Rahu Kaal, Choghadiya, Ekadashi, Purnima, Amavasya, Navratri, Diwali, Holi and regional festivals. Festival observance can vary by location and tradition, so dates must be calculated for your city rather than hardcoded."/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✦  CALIBRATION &amp; ACCURACY" android:textColor="#FFD27A"
            android:textStyle="bold" android:textSize="15sp" android:paddingTop="24dp" android:paddingBottom="7dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="For calibration, slowly move the phone in a figure-eight pattern. Keep it away from magnetic covers, speakers, vehicles and steel furniture. This compass reports magnetic north; true north requires location-based magnetic declination correction."
            android:textColor="#E8CDA7" android:textSize="13sp" android:lineSpacingExtra="5dp"
            android:paddingBottom="30dp"/>
    </LinearLayout>
</ScrollView>
